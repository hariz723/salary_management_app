# PostgreSQL Database Configuration
POSTGRES_USER=salary_user
POSTGRES_PASSWORD=salary_password
POSTGRES_DB=salary_db
POSTGRES_HOST=db
POSTGRES_PORT=5433

# Backend Connection String
# For Docker Compose (inter-container):
DATABASE_URL=postgresql://salary_user:salary_password@db:5432/salary_db

# For Local Development on Host (connecting to Docker PostgreSQL on host port 5433):
# DATABASE_URL=postgresql://salary_user:salary_password@localhost:5433/salary_db

# For Local Development without Docker (SQLite fallback):
# DATABASE_URL=sqlite:///./salary_app.db

# FastAPI Application Settings
PROJECT_NAME="Global Salary Management System"
API_V1_STR=/api/v1
SECRET_KEY=salary_jwt_secret_key_change_in_production_super_secure_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Hugging Face Chatbot Settings
# Create a token with Inference Providers access at https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct-1M:fastest
HUGGINGFACE_API_URL=https://router.huggingface.co/v1/chat/completions
HUGGINGFACE_TIMEOUT_SECONDS=20

# Frontend Configuration
BACKEND_URL=http://backend:8000
VITE_BACKEND_URL=http://localhost:8000
