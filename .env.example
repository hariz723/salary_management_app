
# PostgreSQL Database Configuration
POSTGRES_USER=acme_user
POSTGRES_PASSWORD=acme_password
POSTGRES_DB=salary_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend Connection String
# For Docker Compose:
DATABASE_URL=postgresql://acme_user:acme_password@db:5432/salary_db

# For Local Development without Docker (PostgreSQL):
# DATABASE_URL=postgresql://acme_user:acme_password@localhost:5432/salary_db

# For Local Development without Docker (SQLite fallback):
# DATABASE_URL=sqlite:///./salary_app.db

# FastAPI Application Settings
PROJECT_NAME="ACME Salary Management System"
API_V1_STR=/api/v1
SECRET_KEY=acme_salary_jwt_secret_key_change_in_production_super_secure_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration
BACKEND_URL=http://backend:8000
VITE_BACKEND_URL=http://localhost:8000
