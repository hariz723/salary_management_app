# PostgreSQL Database Configuration
POSTGRES_USER=salary_user
POSTGRES_PASSWORD=salary_password
POSTGRES_DB=salary_db
POSTGRES_HOST=db
POSTGRES_PORT=5433

# Backend Connection String
DATABASE_URL=postgresql://salary_user:salary_password@db:5432/salary_db

# FastAPI Application Settings
PROJECT_NAME="Global Salary Management System"
API_V1_STR=/api/v1
SECRET_KEY=salary_jwt_secret_key_change_in_production_super_secure_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration
BACKEND_URL=http://backend:8000
VITE_BACKEND_URL=http://localhost:8000
